# Copiar a .env.openrouter.local. Solo Docker/servidor; nunca NEXT_PUBLIC_*.
# Por defecto usa OpenRouter: basta con completar la clave.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4.1-nano

# Otro proveedor compatible con OpenAI (chat completions). Si se completan,
# tienen prioridad sobre las de OpenRouter. La URL debe ser https.
# ADVISOR_API_URL=https://api.proveedor.example/v1/chat/completions
# ADVISOR_API_KEY=
# ADVISOR_MODEL=
